/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "temp-mail",
	"main": "src/index.ts",
	"compatibility_date": "2025-07-15",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "D1",
			"database_name": "temp-mail-d1",
			"database_id": "97db4d32-2218-41e7-a532-ccc6b318cb68" // Replace with the ID from `bun run db:create`
		}
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "temp-mail-attachments",
			"preview_bucket_name": "temp-mail-attachments-preview"
		}
	],
	"triggers": {
		"crons": ["0 */2 * * *"]
	},
	/**
	 * Rate limiting (unmetered, edge-local counters).
	 *
	 * AUTH_RATE_LIMITER guards /auth/verify: without it a solver farm can mint
	 * unlimited session cookies. API_RATE_LIMITER caps the data-bearing routes so
	 * a single credential cannot enumerate mailboxes at speed.
	 *
	 * `period` only accepts 10 or 60.
	 */
	"ratelimits": [
		{
			"name": "AUTH_RATE_LIMITER",
			"namespace_id": "2001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "API_RATE_LIMITER",
			"namespace_id": "2002",
			"simple": {
				"limit": 120,
				"period": 60
			}
		}
	],
	"vars": {
		"TELEGRAM_LOG_ENABLE": false,
		"HOURS_TO_DELETE_D1": 3,
		/**
		 * Turnstile sitekey. Public by design — it is embedded in the page HTML.
		 * The matching secret is a Worker secret, never committed:
		 *   bunx wrangler secret put TURNSTILE_SECRET_KEY
		 * Leave empty to disable the bot gate (useful for local dev).
		 */
		"TURNSTILE_SITE_KEY": "0x4AAAAAAETgQrc9q6Fln_51"
	},
	// "assets": { "directory": "./public/" },
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	"placement": { "mode": "smart" },

	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */

	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	// "vars": { "MY_VARIABLE": "production_value" },
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */

	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}
